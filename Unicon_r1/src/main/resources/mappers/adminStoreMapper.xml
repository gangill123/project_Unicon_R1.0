<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Unicon.mapper.adminStoreMapper">
 

<resultMap type="com.Unicon.domain.ImageVO" id="ImageResultMap">
	<id property="image_id" column="image_id"/>
	<id property="image_type" column="image_type"/>
	<id property="image_sequence" column="image_sequence"/>
	<result property="image_src" column="image_src"/>
</resultMap>



<select id="selectStoreMainImg" resultType="ImageVO">
    SELECT *
    FROM _image 
    WHERE image_type = 'storeMain'
</select>


<update id="updateStoreImages" parameterType="List">
    <foreach collection="list" item="li" separator=";">
        UPDATE _image
        SET 
            image_type = #{li.image_type},
            image_sequence = #{li.image_sequence},
            image_src = #{li.image_src}
        WHERE 
            image_id = #{li.image_id}
    </foreach>
</update>




</mapper>
