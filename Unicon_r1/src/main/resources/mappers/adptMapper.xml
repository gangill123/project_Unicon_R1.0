<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Unicon.mapper.adptMapper">
 
<resultMap type="com.Unicon.domain.AnimalVO" id="AnimalResultMap">
	<id property="animal_id" column="animal_id"/>
	<result property="category_code" column="category_code"/>
	<result property="category_etc_value" column="category_etc_value"/>
	<result property="animal_name" column="animal_name"/>
	<result property="animal_color" column="animal_color"/>
	<result property="animal_gender" column="animal_gender"/>
	<result property="gender_value" column="gender_value"/>
	<result property="animal_neuter" column="animal_neuter"/>
	<result property="neuter_value" column="neuter_value"/>
	<result property="animal_age" column="animal_age"/>
	<result property="animal_weight" column="animal_weight"/>
	<result property="weight_value" column="weight_value"/>
	<result property="member_id" column="member_id"/>
	<result property="animal_regdate" column="animal_regdate"/>
	<result property="animal_upddate" column="animal_upddate"/>
	<result property="animal_status" column="animal_status"/>
	<result property="status_value" column="status_value"/>
	<result property="animal_regnum" column="animal_regnum"/>
	<result property="animal_act" column="animal_act"/>
	<result property="act_value" column="act_value"/>
	<result property="animal_social" column="animal_social"/>
	<result property="social_value" column="social_value"/>
	<result property="animal_etc" column="animal_etc"/>
	<result property="adpt_member" column="adpt_member"/>
	
	<association property="adptCounselVO" resultMap="CounselResultMap"/>
	<association property="adptMemberVO" resultMap="MemberResultMap"/>
	<association property="animalInterestVO" resultMap="InterestResultMap"/>
	<association property="adptVO" resultMap="AdptResultMap"/>
	<association property="categoryDataVO" resultMap="CategoryResultMap"/>
	
	<collection property="animal_images" ofType="com.Unicon.domain.ImageVO" resultMap="ImageResultMap"/>
	<collection property="animal_healths" ofType="com.Unicon.domain.AnimalHealthVO" resultMap="HealthResultMap"/>
	<collection property="animal_vaccines" ofType="com.Unicon.domain.AnimalVaccineVO" resultMap="VaccineResultMap"/>
</resultMap>


<resultMap type="com.Unicon.domain.AdptCounselVO" id="CounselResultMap">
	<result property="animal_id" column="animal_id"/>
	<result property="counsel_id" column="counsel_id"/>
	<result property="counsel_subdate" column="counsel_subdate"/>
	<result property="counsel_procdate" column="counsel_procdate"/>
	<result property="counsel_status" column="counsel_status"/>
</resultMap>

<resultMap type="com.Unicon.domain.AdptMemberVO" id="MemberResultMap">
	<result property="member_id" column="member_id"/>
	<result property="member_name" column="member_name"/>
	<result property="member_tel" column="member_tel"/>
	<result property="road_address" column="road_address"/>
	<result property="member_email" column="member_email"/>
	<result property="member_birth" column="member_birth"/>
	<result property="member_gender" column="member_gender"/>
</resultMap>

<resultMap type="com.Unicon.domain.AnimalInterestVO" id="InterestResultMap">
	<id property="animal_id" column="animal_id"/>
	<id property="member_id" column="member_id"/>
	<result property="interest_regdate" column="interest_regdate"/>
	<result property="adpt_interest_sum" column="adpt_interest_sum"/>
</resultMap>

<resultMap type="com.Unicon.domain.AdptVO" id="AdptResultMap">
	<id property="adpt_id" column="adpt_id"/>
	<result property="animal_id" column="animal_id"/>
	<result property="adpt_regdate" column="adpt_regdate"/>
	<result property="adpt_upddate" column="adpt_upddate"/>
	<result property="adpt_intro" column="adpt_intro"/>
	<result property="adpt_etc" column="adpt_etc"/>
</resultMap>

<resultMap type="com.Unicon.domain.ImageVO" id="ImageResultMap">
	<id property="image_id" column="image_id"/>
	<id property="image_type" column="image_type"/>
	<id property="image_sequence" column="image_sequence"/>
	<result property="image_src" column="image_src"/>
</resultMap>

<resultMap type="com.Unicon.domain.AnimalHealthVO" id="HealthResultMap">
	<id property="animal_id" column="animal_id"/>
	<id property="health" column="health"/>
	<result property="health_check" column="health_check"/>
</resultMap>

<resultMap type="com.Unicon.domain.AnimalVaccineVO" id="VaccineResultMap">
	<id property="animal_id" column="animal_id"/>
	<id property="vaccine" column="vaccine"/>
	<result property="vaccine_check" column="vaccine_check"/>
</resultMap>

<resultMap type="com.Unicon.domain.CategoryDataVO" id="CategoryResultMap">
	<id property="category_code" column="category_code"/>
	<result property="category_type" column="category_type"/>
	<result property="category_value" column="category_value"/>
</resultMap>



<insert id="insertAnimal" parameterType="com.Unicon.domain.AnimalVO">
	insert into _animal (animal_id, category_code, category_etc_value, animal_name, animal_color, animal_gender, animal_neuter, animal_age, 
	 animal_weight, member_id, animal_regnum, animal_act, animal_social, animal_etc) 
	  values (#{animal_id}, #{category_code}, #{category_etc_value}, #{animal_name}, #{animal_color}, #{animal_gender}, #{animal_neuter}, 
	   #{animal_age}, #{animal_weight}, #{member_id}, #{animal_regnum}, #{animal_act}, #{animal_social}, #{animal_etc})
</insert>

<insert id="insertAnimalImages" parameterType="List">
	insert into _image (image_id, image_type, image_sequence, image_src) 
	 values 
	  <foreach collection="list" item="li" separator=","> 
	   (#{li.image_id}, #{li.image_type}, #{li.image_sequence}, #{li.image_src}) 
	  </foreach> 
</insert>

<insert id="insertAnimalHealths" parameterType="Map">
	insert into _animal_health (animal_id, health, health_check) 
	 values 
	  <foreach collection="healths" item="h" separator=","> 
	   (#{animal_id}, #{h.health}, #{h.health_check}) 
	  </foreach> 
</insert>

<insert id="insertAnimalVaccines" parameterType="Map">
	insert into _animal_vaccine (animal_id, vaccine, vaccine_check) 
	 values 
	  <foreach collection="vaccines" item="v" separator=","> 
	   (#{animal_id}, #{v.vaccine}, #{v.vaccine_check}) 
	  </foreach> 
</insert>


<select id="checkAnimalId" parameterType="String" resultType="Integer">
	select count(animal_id) 
	 from _animal 
	  where animal_id = #{animal_id} limit 1
</select>


<select id="getAnimalListAll" resultMap="AnimalResultMap">
	select a.animal_id, a.category_etc_value, a.animal_name, date_format(a.animal_regdate, '%Y-%m-%d') as animal_regdate, 
	 c.category_type, c.category_value, 
	  m.member_name, 
	   ac.common_value as status_value 
	    from _animal a 
	     join _category_data c on a.category_code = c.category_code 
	      join _member m on a.member_id = m.member_id 
	       join _common ac on a.animal_status = ac.common_code 
	        where ac.common_column = 'animal_status' and a.animal_status != 6
</select>


<select id="getAnimalListOne" resultMap="AnimalResultMap" parameterType="String">
	select a.animal_id, a.category_etc_value, a.animal_name, a.animal_color, a.animal_gender, 
	 a.animal_neuter, a.animal_age, a.animal_weight, a.member_id, a.animal_regdate, a.animal_status, a.animal_regnum, 
	  a.animal_act, a.animal_social, a.animal_etc, a.adpt_member, 
	   c.category_value, 
	    i.image_id, i.image_type, i.image_sequence, i.image_src, 
	     h.health, h.health_check, 
	      v.vaccine, v.vaccine_check 
		   from _animal a 
		    join _category_data c on a.category_code = c.category_code 
		     join _image i on a.animal_id = i.image_id 
		      join _animal_health h on a.animal_id = h.animal_id 
		       join _animal_vaccine v on a.animal_id = v.animal_id 
		        where a.animal_id = #{animal_id} and a.animal_status != 6
</select>



</mapper>


