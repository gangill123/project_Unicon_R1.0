<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Unicon.mapper.MypageMapper">


<!-- InterestResultMap -->
<resultMap type="com.Unicon.domain.InterestVO" id="InterestResultMap">
<id property="interest_id" column="interest_id"/>
	<result property="product_id" column="product_id"/>
	<result property="member_id" column="member_id"/>
	
	<association property="shopVO" resultMap="ShopResultMap" />
</resultMap>

<!-- ShopResultMap -->
<resultMap type="com.Unicon.domain.ShopVO" id="ShopResultMap">
<id property="product_id" column="product_id"/>
	<result property="product_seller_id" column="product_seller_id"/>
	<result property="product_seller_name" column="product_seller_name"/>
	<result property="product_name" column="product_name"/>
	
	<collection property="product_images" ofType="com.Unicon.domain.ImageVO" resultMap="ImageResultMap"/>
</resultMap>

<!-- "ImageResultMap" -->
<resultMap type="com.Unicon.domain.ImageVO" id="ImageResultMap">
	<id property="image_id" column="image_id"/>
	<id property="image_type" column="image_type"/>
	<id property="image_sequence" column="image_sequence"/>
	<result property="image_src" column="image_src"/>
</resultMap>



	<!-- 펫 카테고리 가져오기 -->
	<select id="getPetType" resultType="CategoryDataVO">
		select * 
		from _category_data 
		where category_parent = #{petOpt} 
	</select>
	
	<!-- 펫 등록하기 -->
	<insert id="createPet">
		insert into _pet(pet_id, member_id, pet_src, pet_name, pet_gender, pet_color, pet_type, pet_code, 
		pet_etc_breed, pet_birthdate, pet_adopdate) 
		values(#{pet_id}, #{member_id}, #{pet_src}, #{pet_name}, #{pet_gender}, #{pet_color}, #{pet_type}, 
		#{pet_code}, #{pet_etc_breed}, #{pet_birthdate}, #{pet_adopdate}) 
	</insert>
	
	<!-- 펫 조회(member_id) -->
	<select id="getPetAll" resultType="PetVO">
		select * from _pet where member_id = #{member_id} 
	</select>
	
	<!-- 펫 조회(pet_id) -->
	<select id="getPet" resultType="PetVO">
		select * from _pet where pet_id = #{pet_id} 
	</select>
	
	<!-- 펫 정보 수정 -->
	<update id="petUpdate">
		update _pet
		set pet_src=#{pet_src}, pet_name=#{pet_name}, pet_gender=#{pet_gender}, pet_color=#{pet_color}, 
		pet_type=#{pet_type}, pet_code=#{pet_code}, pet_etc_breed=#{pet_etc_breed}, pet_birthdate=#{pet_birthdate}, 
		pet_adopdate=#{pet_adopdate} 
		where pet_id = #{pet_id} 
	</update>
	
	<!-- 펫src 가져오기 (삭제용) -->
	<select id="getPetSrc" resultType="String">
		select pet_src 
		from _pet 
		where pet_id = #{pet_id} 
	</select>
	
	<!-- 펫 정보 삭제 -->
	<delete id="petDelete"> 
		delete from _pet 
		where pet_id = #{pet_id}  
	</delete>
	
	
	<!-- 마이페이지 상단 탭(관심상품) 클릭 시 상품관련 정보 가져오기 -->
	<select id="getInterest" resultMap="InterestResultMap" parameterType="String">
		select interest.*, p.product_id, p.product_name, i.* 
		from _interest interest 
		join _products p on interest.product_id = p.product_id 
		join _image i on p.product_id = i.image_id 
		where interest.member_id = #{member_id} 
	</select>
	
	<delete id="delInItem">
		delete from _interest 
		where interest_id = #{interest_id} 
	</delete>
	
	
	
	
	

</mapper>


