<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Unicon.mapper.ShopMapper">


<!-- resultMap 작성란 -->
<resultMap type="com.Unicon.domain.ShopVO" id="ShopResultMap">
	<id property="product_id" column="product_id"/>
	<result property="product_seller_id" column="product_seller_id"/>
	<result property="product_category_type" column="product_category_type"/>
	<result property="product_category_value" column="product_category_value"/>
	<result property="product_keyword" column="product_keyword"/>
	<result property="product_name" column="product_name"/>
	<result property="product_price" column="product_price"/>
	<result property="start_date" column="start_date"/>
	<result property="end_date" column="end_date"/>
	<result property="discount_rate" column="discount_rate"/>
	<result property="product_stock" column="product_stock"/>
	<result property="product_content" column="product_content"/>
	<result property="brand" column="brand"/>
	<result property="manufacturer" column="manufacturer"/>
	<result property="product_origin" column="product_origin"/>
	<result property="product_expiry" column="product_expiry"/>
	<result property="product_status" column="product_status"/>
	<result property="delivery_method" column="delivery_method"/>
	<result property="delivery_price" column="delivery_price"/>
	<result property="address" column="address"/>
	<result property="create_date" column="create_date"/>
	<result property="update_date" column="update_date"/>
	<result property="approval_date" column="approval_date"/>
	<result property="approval_id" column="approval_id"/>
	<result property="comments" column="comments"/>
	<result property="option_type" column="option_type"/>
	
	<association property="memberVO" resultMap="MemberResultMap" />
	<association property="categoryDataVO" resultMap="CategoryDataResultMap" />
	
	<collection property="product_images" ofType="com.Unicon.domain.ImageVO" resultMap="ImageResultMap"/>

</resultMap>


	<!-- Cart용 ResultMap -->
	<resultMap type="com.Unicon.domain.CartVO" id="CartResultMap">
		<id property="cart_id" column="cart_id"/>
		
		<association property="shopVO" resultMap="CartShopResultMap" />
		<collection property="cart_list" ofType="com.Unicon.domain.CartDetailVO" resultMap="CartDetailResultMap"/>
		
	</resultMap>

	<!-- CartProductResultMap -->
	<resultMap type="com.Unicon.domain.ShopVO" id="CartShopResultMap">
		<id property="product_id" column="product_id"/>
		<result property="product_seller_id" column="product_seller_id"/>
		<result property="product_name" column="product_name"/>
		<result property="product_price" column="product_price"/>
		<result property="discount_rate" column="discount_rate"/>
		<result property="delivery_method" column="delivery_method"/>
		<result property="delivery_company" column="delivery_company"/>
		<result property="delivery_price" column="delivery_price"/>
		
		<association property="memberVO" resultMap="MemberResultMap" />
		<collection property="product_images" ofType="com.Unicon.domain.ImageVO" resultMap="ImageResultMap"/>
		
	</resultMap>	
	
	<!-- CartDetailResultMap -->
	<resultMap type="com.Unicon.domain.CartDetailVO" id="CartDetailResultMap">
		<id property="cart_detail_id" column="cart_detail_id"/>
		<result property="cart_id" column="cart_id"/>
		<result property="option_name" column="option_name"/>
		<result property="option_value" column="option_value"/>
		<result property="option_name2" column="option_name2"/>
		<result property="option_value2" column="option_value2"/>
		<result property="quantity" column="quantity"/>
		<result property="option_price" column="option_price"/>
	</resultMap>

<!-- CategoryResultMap -->
<resultMap type="com.Unicon.domain.CategoryDataVO" id="CategoryDataResultMap">
	<id property="category_code" column="category_code"/>
	<result property="category_type" column="category_type"/>
	<result property="category_value" column="category_value"/>
	<result property="category_parent" column="category_parent"/>
</resultMap>

<!-- MemberResultMap -->
<resultMap type="com.Unicon.domain.MemberVO" id="MemberResultMap">
	<result property="memberId" column="member_id"/>
	<result property="memberName" column="member_name"/>
</resultMap>

<!-- "ImageResultMap" -->
<resultMap type="com.Unicon.domain.ImageVO" id="ImageResultMap">
	<id property="image_id" column="image_id"/>
	<id property="image_type" column="image_type"/>
	<id property="image_sequence" column="image_sequence"/>
	<result property="image_src" column="image_src"/>
</resultMap>

	<!-- shop 페이지 접속 시 모든 상품정보 가져오기 -->
	<select id="getProductAll" resultMap="ShopResultMap">
		select p.*, i.* 
		from _products p 
		join _image i on p.product_id = i.image_id 
	</select>

	<!-- 상세페이지 이동시 해당제품 상품정보 가져오기 -->
	<select id="getProduct" resultMap="ShopResultMap" parameterType="String">
		select p.*, i.*, m.member_name 
		from _products p 
		join _image i on p.product_id = i.image_id 
		join _member m on p.product_seller_id = m.member_id 
		where p.product_id = #{product_id} 
	</select>
	
	<!-- 옵션1 정보 가져오기(가격제외) -->
	<select id="getOption1" resultType="OptionVO">
		select distinct option_name, option_value, option_name2 
		from _option 
		where product_id = #{product_id} 
	</select>
	
	<!-- 옵션1 정보 가져오기(가격포함) -->
	<select id="getOption1ForSole" resultType="OptionVO">
		select distinct option_name, option_value, option_price, option_stock, option_name2 
		from _option 
		where product_id = #{product_id} 
	</select>
	
	<!-- 단독형 - 옵션 선택 시 해당 옵션가격 가져오기 -->
	<select id="getSoleOptionPrice" parameterType="map" resultType="int">
		select option_price 
		from _option 
		where product_id = #{product_id} and option_value = #{option_value} 
	</select>
	
	
	<!-- 조합형 - 옵션1 선택시 옵션2 가져오기 -->
	<select id="getOption" parameterType="map" resultType="OptionVO">
		select distinct option_name2, option_value2, option_price 
		from _option 
		where product_id = #{product_id} and option_value = #{option_value} 
	</select>
	
	<!-- 조합형 - 옵션1 옵션2 선택시 옵션가격 가져오기 -->
	<select id="getOptionPrice" parameterType="map" resultType="int">
		select option_price 
		from _option 
		where product_id = #{product_id} and option_value = #{option_value} and option_value2 = #{option_value2} 
	</select>

	<!-- 최신 cart번호 가져오기 -->
	<select id="getCartid" resultType="int">
		select cart_id from _cart order by cart_id desc limit 1
	</select>

	<!-- 상세페이지에서 선택한 상품정보 cart, cart_detail 저장하기 -->
	<!-- cart 테이블 저장 -->
	<insert id="saveCart">
		insert into _cart(cart_id, member_id, product_id) 
		values(${cart_id}, #{member_id}, #{product_id}) 
	</insert>

	<!-- cart detail 테이블 저장 -->
	<insert id="saveCartDetail" parameterType="List">
		insert into _cart_detail(cart_id, option_name, option_value, 
		option_name2, option_value2, quantity, option_price) 
		values
		<foreach collection="list" item="li" separator=","> 
	   (#{li.cart_id}, #{li.option_name}, #{li.option_value}, #{li.option_name2}, #{li.option_value2}, 
	   #{li.quantity}, #{li.option_price}) 
	  </foreach> 
	</insert>


	<!-- 장바구니 페이지 이동 시 장바구니 정보 가져오기 -->
	<select id="getCartAll" resultMap="CartResultMap" parameterType="String">
		select c.cart_id, p.product_id, p.product_name, p.product_price, p.discount_rate, 
		p.delivery_method, p.delivery_price, d.*, m.member_name, i.* 
		from _cart c 
		join _cart_detail d on c.cart_id = d.cart_id 
		join _products p on c.product_id = p.product_id 
		join _member m on p.product_seller_id = m.member_id 
		join _image i on p.product_id = i.image_id 
		where m.member_id = #{member_id} 
	</select>



</mapper>


