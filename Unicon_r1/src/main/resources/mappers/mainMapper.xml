<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Unicon.mapper.MainMapper">

	<!-- 장바구니 수량 가져와서 세션저장 -->	
	<select id="getCartCount" resultType="int">
		select count(*) 
		from _cart 
		where member_id = #{member_id} 
	</select>
	
	<!-- 입양 공고수 가져오기 -->
	<select id="getAdptCnt" resultType="int">
		select count(*) 
		from _adpt 
	</select>
	
	<!-- 입양완료 동물 수 가져오기 -->
	<select id="getAnimalCnt" resultType="int">
		select count(*) 
		from _animal 
	</select>
	
	<!-- 게시물 수 가져오기 -->
	<select id="getPostCnt" resultType="int">
		select count(*) 
		from _post 
	</select>
	
	<!-- 센터 수 가져오기 -->
	<select id="getCenterCnt" resultType="int">
		select count(*) 
		from _member 
	</select>
	
	
	<!-- 멤버 사진 가져와서 세션 저장 -->
	<select id="getMemberImage" resultType="String">
		select member_image 
		from _member 
		where member_id = #{member_id} 
	</select>
	
	
	
	


</mapper>


