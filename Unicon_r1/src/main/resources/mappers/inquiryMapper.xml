<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.unicon.mapper.InquiryMapper">


	<resultMap id="BoardDetailResultMap"
		type="com.Unicon.domain.InquiryVO">
		<!-- InquiryVO 매핑 -->
		<id column="bno" property="bno" />
		<result column="member_id" property="member_id" />
		<result column="member_name" property="member_name" />
		<result column="title" property="title" />
		<result column="content" property="content" />
		<result column="istatus" property="istatus" />
		<result column="created_at" property="created_at" />
		<result column="status" property="status" />
		<result column="email" property="email" />
		<result column="phone" property="phone" />
		<result column="view_count" property="view_count" />

		<!-- InquiryFileVO 매핑 -->
		<association property="inquiryFile"
			javaType="com.Unicon.domain.InquiryFileVO">
			<id column="fileId" property="fileId" />
			<result column="fileBno" property="bno" />
			<result column="originalName" property="originalName" />
			<result column="storedName" property="storedName" />
			<result column="filePath" property="filePath" />
			<result column="fileType" property="fileType" />
			<result column="uploadDate" property="uploadDate" />
			<result column="thumbnailPath" property="thumbnailPath" />
		</association>
	</resultMap>



	<!-- 게시글 목록 조회 -->
	<select id="getAllInquiries" resultType="InquiryVO">
		SELECT *
		FROM _inquiry
		ORDER BY created_at DESC
	</select>

	<!-- 페이징처리 -->
	<select id="getBoards" parameterType="map"
		resultType="InquiryVO">
		SELECT *
		FROM _inquiry
		ORDER BY bno DESC
		LIMIT #{limit}
		OFFSET
		#{offset}
	</select>

	<select id="getTotalCount" resultType="int">
		SELECT COUNT(*)
		FROM
		_inquiry
	</select>

	<!-- 문의 데이터 삽입 -->
	<insert id="insertInquiry" useGeneratedKeys="true"
		keyProperty="bno">
		INSERT INTO _inquiry (member_id, member_name, title,
		content, created_at,
		istatus, email, phone, post_password)
		VALUES (#{member_id},
		#{member_name}, #{title}, #{content}, now(),
		#{istatus}, #{email},
		#{phone}, #{post_password})
	</insert>

	<!-- 파일 정보를 데이터베이스에 삽입하는 SQL -->
	<insert id="insertFile"
		parameterType="com.Unicon.domain.InquiryFileVO">
		INSERT INTO _inquiry_file (bno, originalName,
		storedName, filePath,
		fileType, uploadDate, thumbnailPath)
		VALUES
		(#{bno}, #{originalName}, #{storedName}, #{filePath}, #{fileType},
		#{uploadDate}, #{thumbnailPath})
	</insert>


	<select id="getBoardDetail" parameterType="int"
		resultMap="BoardDetailResultMap">
		SELECT
		i.bno,
		i.member_id,
		i.member_name,
		i.title,
		i.content,
		i.istatus,
		i.created_at,
		i.status,
		i.email,
		i.phone,
		i.view_count,
		f.fileId,
		COALESCE(f.bno, i.bno) AS fileBno,
		f.originalName,
		f.storedName,
		f.filePath,
		f.fileType,
		f.uploadDate,
		f.thumbnailPath
		FROM
		_inquiry i
		LEFT
		JOIN
		_inquiry_file f
		ON
		i.bno = f.bno
		WHERE
		i.bno = #{bno}
	</select>

	<!-- 답변 매퍼 -->

	<!-- 답변 추가 쿼리 -->
	<insert id="insertAnswer">
		INSERT INTO _inquiry_answer (bno, dname, dcontent, created_at)
		VALUES (#{bno}, #{dname}, #{dcontent}, CURRENT_TIMESTAMP)
	</insert>

	<!-- 해당 bno에 대해 _inquiry 테이블의 status 값을 2로 업데이트 -->
	<update id="updateInquiryStatus">
		UPDATE _inquiry
		SET status = 2
		WHERE bno = #{bno}
	</update>


	<!-- 게시글 번호에 해당하는 답변 조회 -->
	<select id="getAnswersByBno"
		resultType="com.Unicon.domain.InquiryAnswerVO">
		SELECT * FROM _inquiry_answer
		WHERE bno = #{bno}
	</select>


	<!-- 답변 수정 -->
	<update id="updateAnswer">
		UPDATE _inquiry_answer
		SET dcontent = #{dcontent}
		WHERE dno = #{dno}
	</update>

	<!-- 답변 삭제 -->
	<delete id="deleteAnswer">
		DELETE FROM _inquiry_answer
		WHERE dno = #{dno}
	</delete>

	<!-- 답변 조회 (수정 폼용) -->
	<select id="getAnswerByDno"
		resultType="com.Unicon.domain.InquiryAnswerVO">
		SELECT * FROM _inquiry_answer
		WHERE dno = #{dno}
	</select>
	
   	<select id="getInquiryByBno" parameterType="int" resultType="com.Unicon.domain.InquiryVO">
        SELECT 
            bno,
            istatus,
            title,
            member_name,
            created_at,
            status,
            post_password
        FROM 
            _inquiry
        WHERE 
            bno = #{bno}
    </select>
    
    <!-- 조회수  -->
    <update id="updateViewCount" parameterType="int">
	    UPDATE _inquiry
	    SET view_count = view_count + 1
	    WHERE bno = #{bno}
	</update>



</mapper>